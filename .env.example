# Never place real secrets in this file in source control.

NETSIGHT_ENV=development
# Local-only identity bridge. Requires NETSIGHT_ENV=development as a second gate.
NETSIGHT_ENABLE_DEV_IDENTITY=false
# VPS web listener. The public reverse proxy currently targets loopback port 2000.
NETSIGHT_WEB_PORT=2000
# Deployment guard; update this only with the reverse-proxy upstream in the same approved change.
NETSIGHT_EXPECTED_PROXY_PORT=2000
DATABASE_URL=postgresql+psycopg://netsight:CHANGE_ME@localhost:5432/netsight
REDIS_URL=redis://localhost:6379/0

# OIDC
NETSIGHT_PUBLIC_BASE_URL=
NETSIGHT_ROLE_CLAIM=roles
NETSIGHT_ROLE_MAPPING={}
NETSIGHT_DEFAULT_ROLE=

NETSIGHT_OIDC_MICROSOFT_ENABLED=false
NETSIGHT_OIDC_MICROSOFT_CLIENT_ID=
NETSIGHT_OIDC_MICROSOFT_CLIENT_SECRET=
NETSIGHT_OIDC_MICROSOFT_AUTHORITY=
NETSIGHT_OIDC_MICROSOFT_TENANT_IDS=

NETSIGHT_OIDC_GOOGLE_ENABLED=false
NETSIGHT_OIDC_GOOGLE_CLIENT_ID=
NETSIGHT_OIDC_GOOGLE_CLIENT_SECRET=
NETSIGHT_OIDC_GOOGLE_AUTHORITY=https://accounts.google.com
NETSIGHT_OIDC_GOOGLE_HOSTED_DOMAINS=
NETSIGHT_OIDC_GOOGLE_ALLOWED_IDENTITIES=

NETSIGHT_SESSION_SECRET=
NETSIGHT_SESSION_COOKIE_NAME=netsight_session
NETSIGHT_SESSION_COOKIE_SAMESITE=lax
NETSIGHT_SESSION_IDLE_TIMEOUT_SECONDS=1800
NETSIGHT_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
NETSIGHT_SESSION_COOKIE_SECURE=true
# Step-up: incident resolve/reopen need a second factor proven within this many seconds
# (1-86400, default 900). An unknown or older second factor is refused with STEP_UP_REQUIRED.
NETSIGHT_STEP_UP_MAX_AGE_SECONDS=900

# Netsight-managed local credentials (ADR 0010). Optional; the federated
# providers above remain available. MFA is mandatory for these accounts and a
# password alone never grants a session.
# Where the account file lives. The API and the operator CLI both read it, so
# it must be readable and writable by the service account. Written 0600.
# NETSIGHT_SESSION_SECRET is required before local sign-in works: it encrypts
# TOTP secrets at rest and signs session cookies.
NETSIGHT_LOCAL_ACCOUNT_FILE=

# Integrations
LIBRENMS_BASE_URL=
LIBRENMS_TOKEN=
# Required to normalize LibreNMS API timestamps that omit an offset (for example, Africa/Windhoek).
LIBRENMS_TIMEZONE=
NETBOX_BASE_URL=
NETBOX_TOKEN=
# Wazuh indexer (read-only, Security Centre). Unset URL = not-connected. Use a least-privilege
# read-only indexer user; credentials are only sent over https.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# Optional PEM bundle to trust a private CA for the indexer (TLS verification is always on).
WAZUH_INDEXER_CA_BUNDLE=
# Must start with wazuh-.
WAZUH_ALERTS_INDEX=wazuh-alerts-*
# Development only: allow credentials over plain http. Ignored unless NETSIGHT_ENV=development.
#WAZUH_INDEXER_ALLOW_HTTP=false
CLICKHOUSE_DSN=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_FLOWS_TABLE=flows
GRAFANA_BASE_URL=
GRAFANA_TOKEN=
OXIDIZED_BASE_URL=
BLACKBOX_BASE_URL=

# AI
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Notification webhooks (S6-3). Deny by default: nothing is called unless its host is listed.
# Exact hosts or *.example.com (subdomains only); IP literals and private targets are never allowed.
NETSIGHT_WEBHOOK_ALLOWED_HOSTS=
#NETSIGHT_WEBHOOK_ALLOWED_PORTS=443
#NETSIGHT_WEBHOOK_TIMEOUT_SECONDS=5
#NETSIGHT_WEBHOOK_MAX_RESPONSE_BYTES=65536
#NETSIGHT_NOTIFY_MAX_ATTEMPTS=3
#NETSIGHT_NOTIFY_QUEUE_LIMIT=1000

# Alert evaluation service (S6 step 2). OFF unless explicitly enabled; enabled needs DATABASE_URL
# (the least-privilege app role) and fails start-up without it. Run exactly one evaluator per
# database. Reads LibreNMS (LIBRENMS_*), evaluates approved rules only, opens deduplicated
# incidents as service:alert-evaluator (never resolves them) and sends notifications.
NETSIGHT_EVALUATION_ENABLED=false
#NETSIGHT_EVALUATION_INTERVAL_SECONDS=60

# Email: SMTP relay, TLS required (starttls on 587, or tls on 465). There is no plaintext mode.
# Unset NETSIGHT_SMTP_HOST = no email sender (deliveries are recorded as NO_SENDER).
NETSIGHT_SMTP_HOST=
#NETSIGHT_SMTP_PORT=587
#NETSIGHT_SMTP_TLS=starttls
NETSIGHT_SMTP_FROM=
NETSIGHT_SMTP_USERNAME=
NETSIGHT_SMTP_PASSWORD=
#NETSIGHT_SMTP_TIMEOUT_SECONDS=10
#NETSIGHT_SMTP_CA_BUNDLE=

# Push: an HTTPS gateway you run or contract (provider-agnostic). The gateway host must also be
# listed in NETSIGHT_WEBHOOK_ALLOWED_HOSTS. The URL and token are secrets.
NETSIGHT_PUSH_GATEWAY_URL=
NETSIGHT_PUSH_GATEWAY_TOKEN=

# Who is notified: comma-separated lists; unset = nobody. Alerts below the minimum severity are
# not sent (info|low|medium|high|critical). NETSIGHT_PUBLIC_BASE_URL (above, https) is required
# for notification links; without it nothing is sent.
NETSIGHT_NOTIFY_EMAIL_TO=
NETSIGHT_NOTIFY_PUSH_DEVICES=
#NETSIGHT_NOTIFY_MIN_SEVERITY=high
