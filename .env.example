# Never place real secrets in this file in source control.

NETSIGHT_ENV=development
# Local-only identity bridge. Requires NETSIGHT_ENV=development as a second gate.
NETSIGHT_ENABLE_DEV_IDENTITY=false
DATABASE_URL=postgresql+psycopg://netsight:CHANGE_ME@localhost:5432/netsight
REDIS_URL=redis://localhost:6379/0

# OIDC
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_ALLOWED_TENANT_IDS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_WORKSPACE_DOMAINS=

# Integrations
LIBRENMS_BASE_URL=
LIBRENMS_TOKEN=
# Required to normalize LibreNMS API timestamps that omit an offset (for example, Africa/Windhoek).
LIBRENMS_TIMEZONE=
NETBOX_BASE_URL=
NETBOX_TOKEN=
WAZUH_BASE_URL=
WAZUH_TOKEN=
CLICKHOUSE_DSN=
GRAFANA_BASE_URL=
GRAFANA_TOKEN=
OXIDIZED_BASE_URL=
BLACKBOX_BASE_URL=

# AI
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=
