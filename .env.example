# Never place real secrets in this file in source control.

NETSIGHT_ENV=development
# Local-only identity bridge. Requires NETSIGHT_ENV=development as a second gate.
NETSIGHT_ENABLE_DEV_IDENTITY=false
# VPS web listener. The public reverse proxy currently targets loopback port 2000.
NETSIGHT_WEB_PORT=2000
# Deployment guard; update this only with the reverse-proxy upstream in the same approved change.
NETSIGHT_EXPECTED_PROXY_PORT=2000
DATABASE_URL=postgresql+psycopg://netsight:CHANGE_ME@localhost:5432/netsight
REDIS_URL=redis://localhost:6379/0

# OIDC
NETSIGHT_PUBLIC_BASE_URL=
NETSIGHT_ROLE_CLAIM=roles
NETSIGHT_ROLE_MAPPING={}
NETSIGHT_DEFAULT_ROLE=

NETSIGHT_OIDC_MICROSOFT_ENABLED=false
NETSIGHT_OIDC_MICROSOFT_CLIENT_ID=
NETSIGHT_OIDC_MICROSOFT_CLIENT_SECRET=
NETSIGHT_OIDC_MICROSOFT_AUTHORITY=
NETSIGHT_OIDC_MICROSOFT_TENANT_IDS=

NETSIGHT_OIDC_GOOGLE_ENABLED=false
NETSIGHT_OIDC_GOOGLE_CLIENT_ID=
NETSIGHT_OIDC_GOOGLE_CLIENT_SECRET=
NETSIGHT_OIDC_GOOGLE_AUTHORITY=https://accounts.google.com
NETSIGHT_OIDC_GOOGLE_HOSTED_DOMAINS=
NETSIGHT_OIDC_GOOGLE_ALLOWED_IDENTITIES=

NETSIGHT_SESSION_SECRET=
NETSIGHT_SESSION_COOKIE_NAME=netsight_session
NETSIGHT_SESSION_COOKIE_SAMESITE=lax
NETSIGHT_SESSION_IDLE_TIMEOUT_SECONDS=1800
NETSIGHT_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
NETSIGHT_SESSION_COOKIE_SECURE=true
# Step-up: incident resolve/reopen need a second factor proven within this many seconds
# (1-86400, default 900). An unknown or older second factor is refused with STEP_UP_REQUIRED.
NETSIGHT_STEP_UP_MAX_AGE_SECONDS=900

# Netsight-managed local credentials (ADR 0010). Optional; the federated
# providers above remain available. MFA is mandatory for these accounts and a
# password alone never grants a session.
# Where the account file lives. The API and the operator CLI both read it, so
# it must be readable and writable by the service account. Written 0600.
# NETSIGHT_SESSION_SECRET is required before local sign-in works: it encrypts
# TOTP secrets at rest and signs session cookies.
NETSIGHT_LOCAL_ACCOUNT_FILE=

# Integrations
LIBRENMS_BASE_URL=
LIBRENMS_TOKEN=
# Required to normalize LibreNMS API timestamps that omit an offset (for example, Africa/Windhoek).
LIBRENMS_TIMEZONE=
NETBOX_BASE_URL=
NETBOX_TOKEN=
# Wazuh indexer (read-only, Security Centre). Unset URL = not-connected. Use a least-privilege
# read-only indexer user; credentials are only sent over https.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USER=
WAZUH_INDEXER_PASSWORD=
# Optional PEM bundle to trust a private CA for the indexer (TLS verification is always on).
WAZUH_INDEXER_CA_BUNDLE=
# Must start with wazuh-.
WAZUH_ALERTS_INDEX=wazuh-alerts-*
# Development only: allow credentials over plain http. Ignored unless NETSIGHT_ENV=development.
#WAZUH_INDEXER_ALLOW_HTTP=false
CLICKHOUSE_DSN=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_FLOWS_TABLE=flows
GRAFANA_BASE_URL=
GRAFANA_TOKEN=
OXIDIZED_BASE_URL=
BLACKBOX_BASE_URL=
# Diagnostics probe sources (S7). No allow-list = no probing: the endpoint answers not-connected.
# Plain names/addresses only (letters, digits . _ : -); wildcards, CIDR, URLs are dropped and counted.
#BLACKBOX_ALLOWED_TARGETS=srv-01,10.0.5.20
# Where the API host's own prober sits: cloud-external|user-lan|server-vlan|branch|wifi|remote-site.
#BLACKBOX_LOCATION=
# Blackbox exporter per location, read-only GET /probe; URL is operator config (no credentials/query/path).
#BLACKBOX_EXPORTER_SOURCES=cloud-external=https://probe-ext.example:9115,server-vlan=https://probe-vlan.example:9115
# Per-probe wall-clock deadline for exporter sources; keep it above the exporter modules' own timeout.
#BLACKBOX_TIMEOUT_SECONDS=5
# Diagnostic sessions stored per 24 h before runs are answered but not stored (1-1000000, default 5000;
# invalid = nothing is stored). Sessions are immutable and have no prune path yet.
#NETSIGHT_DIAGNOSTIC_SESSIONS_DAILY_CAP=5000

# Internet/WAN (Step 5). Netsight never guesses which interface is a WAN link: declare each one as a JSON
# array (at most 8, at most one primary). Unset = /internet answers not-connected; any invalid entry makes
# the whole declaration unknown. Fields: id, name, role (primary|backup), isp, gateway (IP), librenms_device
# and librenms_port (LibreNMS native ids, both or neither), probe_targets (hosts in BLACKBOX_ALLOWED_TARGETS),
# probe_location (an exporter location), dns_target, uptime_target_pct (the ISP SLA value; no target = no violation).
#NETSIGHT_WAN_LINKS=[{"id":"fibre-1","name":"Primary fibre","role":"primary","isp":"Example ISP","gateway":"192.0.2.1","librenms_device":"12","librenms_port":"345","probe_targets":["probe-a.example"],"probe_location":"branch","uptime_target_pct":99.5}]
# WAN probe sampling (SLA evidence): OFF unless explicitly enabled. Enabled needs NETSIGHT_WAN_COLLECTOR_DATABASE_URL and a
# usable NETSIGHT_WAN_LINKS, or start-up fails. Run exactly one collector per database (an advisory lock enforces it).
# Probes use the existing allow-listed Blackbox clients above; rows are append-only and have no prune path yet (retention is a
# pending human decision; when decided it is a migrator drop of month partitions).
# The collector writes with its OWN database role: INSERT only on wan_link_cycles / wan_probe_samples, nothing else. It must not be
# DATABASE_URL's role (that one is SELECT only on those tables), a superuser, a row-security bypass or the table owner (checked at
# start-up). Create the role out of band, then grant it with the migrator:
#   DATABASE_MIGRATION_URL=... DATABASE_APP_ROLE=netsight_app DATABASE_WAN_COLLECTOR_ROLE=netsight_wan \
#     python -m netsight_api.storage.migrate up
# The WAN tables are partitioned by month; the migrator creates the current and next month on `up`. Schedule
#   python -m netsight_api.storage.migrate partitions      (monthly; idempotent)
# so next month's partition exists, or the collector refuses to write (and logs it) until it does.
#NETSIGHT_WAN_SAMPLING_ENABLED=false
#NETSIGHT_WAN_SAMPLE_INTERVAL_SECONDS=60
#NETSIGHT_WAN_COLLECTOR_DATABASE_URL=postgresql+psycopg://netsight_wan:CHANGE_ME@localhost:5432/netsight

# AI
AI_PROVIDER=
AI_MODEL=
AI_API_KEY=

# Notification webhooks (S6-3). Deny by default: nothing is called unless its host is listed.
# Exact hosts or *.example.com (subdomains only); IP literals and private targets are never allowed.
NETSIGHT_WEBHOOK_ALLOWED_HOSTS=
#NETSIGHT_WEBHOOK_ALLOWED_PORTS=443
#NETSIGHT_WEBHOOK_TIMEOUT_SECONDS=5
#NETSIGHT_WEBHOOK_MAX_RESPONSE_BYTES=65536
#NETSIGHT_NOTIFY_MAX_ATTEMPTS=3
#NETSIGHT_NOTIFY_QUEUE_LIMIT=1000

# Alert evaluation service (S6 step 2). OFF unless explicitly enabled; enabled needs DATABASE_URL
# (the least-privilege app role) and fails start-up without it. Run exactly one evaluator per
# database. Reads LibreNMS (LIBRENMS_*), evaluates approved rules only, opens deduplicated
# incidents as service:alert-evaluator (never resolves them) and sends notifications.
NETSIGHT_EVALUATION_ENABLED=false
#NETSIGHT_EVALUATION_INTERVAL_SECONDS=60

# Email: SMTP relay, TLS required (starttls on 587, or tls on 465). There is no plaintext mode.
# Unset NETSIGHT_SMTP_HOST = no email sender (deliveries are recorded as NO_SENDER).
NETSIGHT_SMTP_HOST=
#NETSIGHT_SMTP_PORT=587
#NETSIGHT_SMTP_TLS=starttls
NETSIGHT_SMTP_FROM=
NETSIGHT_SMTP_USERNAME=
NETSIGHT_SMTP_PASSWORD=
#NETSIGHT_SMTP_TIMEOUT_SECONDS=10
#NETSIGHT_SMTP_CA_BUNDLE=

# Push: an HTTPS gateway you run or contract (provider-agnostic). The gateway host must also be
# listed in NETSIGHT_WEBHOOK_ALLOWED_HOSTS. The URL and token are secrets.
NETSIGHT_PUSH_GATEWAY_URL=
NETSIGHT_PUSH_GATEWAY_TOKEN=

# Who is notified: comma-separated lists; unset = nobody. Alerts below the minimum severity are
# not sent (info|low|medium|high|critical). NETSIGHT_PUBLIC_BASE_URL (above, https) is required
# for notification links; without it nothing is sent.
NETSIGHT_NOTIFY_EMAIL_TO=
NETSIGHT_NOTIFY_PUSH_DEVICES=
#NETSIGHT_NOTIFY_MIN_SEVERITY=high

# Web server actions compare the browser's Origin with this site (scheme + host). X-Forwarded-Host and
# X-Forwarded-Proto are honoured ONLY when this is exactly "true", and only behind a reverse proxy that
# overwrites both headers (see docs/02-security/THREAT-MODEL.md). Leave unset otherwise.
#NETSIGHT_TRUST_PROXY_HEADERS=true

# Identity correlation (Step 6). Read-only; computed on read, nothing is stored. Evidence comes from the Wazuh indexer
# (agent inventory) and NetBox (contact and address assignments) configured above; unset = not-connected.
#WAZUH_AGENTS_INDEX=wazuh-monitoring-*
# NetBox contact roles that mean "uses this device" (comma-separated, case-insensitive; default Owner,User).
#NETSIGHT_NETBOX_OWNER_ROLES=Owner,User
# The ONLY join between a NetBox device and its Wazuh agent: the name of a NetBox *device* custom field (lower-case
# letters, digits, underscore) holding the Wazuh agent id exactly as Wazuh shows it (for example 001). Never a hostname
# or agent name (spoofable). Unset = devices are not joined and one host conflicts with itself (fails safe).
#NETSIGHT_NETBOX_WAZUH_AGENT_FIELD=wazuh_agent_id
# Network classification the engine cannot learn from evidence. Public, documentation and CGNAT addresses are always
# treated as shared (never identity). A malformed value makes the identity routes answer `unknown`, never a guess.
#NETSIGHT_IDENTITY_SHARED_CIDRS=10.9.9.0/24
#NETSIGHT_IDENTITY_INTERNAL_CIDRS=198.51.100.0/24
#NETSIGHT_IDENTITY_VPN_CIDRS=10.200.0.0/16
#NETSIGHT_IDENTITY_GUEST_CIDRS=192.168.99.0/24
#NETSIGHT_IDENTITY_GUEST_VLANS=99
# Deployment prerequisite: the engine cannot learn guest/NAT networks. An unlisted guest or shared range is treated as
# ordinary internal space, so list every one before relying on an answer.
# Server / static-assignment ranges: an endpoint agent's claim to an address here is ignored (a rogue agent cannot
# weaken a registered server's attribution).
#NETSIGHT_IDENTITY_STATIC_CIDRS=10.0.0.0/24
# Secret (>= 32 characters) keying the opaque evidence ids shown to read-limited callers (HMAC-SHA-256). Required; without
# it those callers get `unknown`. Only NETSIGHT_ENV=development generates a per-process key. Generate, never commit:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#NETSIGHT_IDENTITY_ID_KEY=
