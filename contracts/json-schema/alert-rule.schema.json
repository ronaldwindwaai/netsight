{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlertRule",
  "description": "Alert rule independent of any upstream alert product (ALERT-ENGINE.md). PostgreSQL-owned. A rule is created as a draft and becomes active only through explicit approval (natural-language or otherwise): status 'active' requires approved_by and approved_at, 'draft' forbids them, and approved_by/approved_at are always both set or both null. condition.operator 'matches' takes a pattern (threshold null); every other operator takes a numeric threshold (pattern null).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "status",
    "scope",
    "condition",
    "baseline_mode",
    "window_seconds",
    "for_seconds",
    "cooldown_seconds",
    "schedule",
    "exceptions",
    "severity",
    "labels",
    "actions",
    "incident_policy",
    "created_by",
    "created_at",
    "updated_at",
    "approved_by",
    "approved_at",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 47,
      "maxLength": 47,
      "pattern": "^alert-rule-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "draft",
        "active",
        "disabled"
      ]
    },
    "scope": {
      "$ref": "#/$defs/scope"
    },
    "condition": {
      "$ref": "#/$defs/condition"
    },
    "baseline_mode": {
      "description": "none: compare against the threshold only; otherwise compare against the baseline detector output (AnomalySignal) in the given direction.",
      "enum": [
        "none",
        "above-baseline",
        "below-baseline",
        "outside-baseline"
      ]
    },
    "window_seconds": {
      "description": "Aggregation window the condition is evaluated over.",
      "type": "integer",
      "minimum": 60,
      "maximum": 86400
    },
    "for_seconds": {
      "description": "Duration the condition must hold before firing (debounce); 0 fires immediately.",
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "cooldown_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 604800
    },
    "schedule": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/schedule"
        }
      ]
    },
    "exceptions": {
      "$ref": "#/$defs/exceptions"
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "labels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,62}$"
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 128
      }
    },
    "actions": {
      "description": "Rule actions. These only create alerts and notifications; remote write actions go through the action framework, never through a rule.",
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "create_alert",
          "email",
          "push"
        ]
      }
    },
    "incident_policy": {
      "enum": [
        "none",
        "create",
        "group"
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 255
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "version": {
      "description": "Increments on every change; supports optimistic concurrency.",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "active"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "string"
          },
          "approved_at": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "draft"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "approved_by": {
            "type": "null"
          },
          "approved_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approved_by": {
            "type": "string"
          }
        },
        "required": [
          "approved_by"
        ]
      },
      "then": {
        "properties": {
          "approved_at": {
            "type": "string"
          }
        }
      },
      "else": {
        "properties": {
          "approved_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "organisation",
            "site",
            "device",
            "device_group",
            "vlan",
            "user",
            "service"
          ]
        },
        "ref": {
          "description": "Canonical identifier or group name of the scoped entity.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "operator",
        "threshold",
        "pattern"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"
        },
        "operator": {
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "ne",
            "matches"
          ]
        },
        "threshold": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        },
        "pattern": {
          "description": "Pattern for the 'matches' operator. Must be evaluated with a linear-time matcher, never a backtracking engine.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": {
                "const": "matches"
              }
            },
            "required": [
              "operator"
            ]
          },
          "then": {
            "properties": {
              "threshold": {
                "type": "null"
              },
              "pattern": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "threshold": {
                "type": "number"
              },
              "pattern": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "schedule": {
      "description": "Times of day when the rule is active, in the given IANA timezone. A window whose 'to' is earlier than 'from' crosses midnight; equal values mean the whole day.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timezone",
        "active"
      ],
      "properties": {
        "timezone": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^(UTC|[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z][A-Za-z0-9_+-]*){1,2})$"
        },
        "active": {
          "type": "array",
          "minItems": 1,
          "maxItems": 14,
          "items": {
            "$ref": "#/$defs/scheduleEntry"
          }
        }
      }
    },
    "scheduleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "weekdays",
        "from",
        "to"
      ],
      "properties": {
        "weekdays": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          }
        },
        "from": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "to": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
        }
      }
    },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destinations",
        "device_groups"
      ],
      "properties": {
        "destinations": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "device_groups": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "maintenanceWindow": {
      "description": "Maintenance suppresses notifications and actions for the scope but keeps evaluating and retaining evidence unless evaluation is 'disable'. Status is scheduled|cancelled; active/expired are derived from the clock and never stored. status 'cancelled' requires cancelled_by and cancelled_at, 'scheduled' forbids them. Cross-field rules not expressible in JSON Schema and enforced by the API models, the store and the browser parser: ends_at must be after starts_at and at most 30 days later.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "scope",
        "starts_at",
        "ends_at",
        "evaluation",
        "status",
        "reason",
        "created_by",
        "created_at",
        "cancelled_by",
        "cancelled_at"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 48,
          "maxLength": 48,
          "pattern": "^maintenance-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "evaluation": {
          "enum": [
            "retain",
            "disable"
          ]
        },
        "status": {
          "enum": [
            "scheduled",
            "cancelled"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "created_by": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "cancelled_by": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 255
        },
        "cancelled_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "cancelled"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "cancelled_by": {
                "type": "string"
              },
              "cancelled_at": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "cancelled_by": {
                "type": "null"
              },
              "cancelled_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
