{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interface",
  "type": "object",
  "required": [
    "id",
    "device_id",
    "name",
    "admin_status",
    "oper_status",
    "source_aliases",
    "freshness"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^interface-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^device-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "index": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "alias": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 255
    },
    "hardware_type": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "mac_address": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "admin_status": {
      "enum": ["up", "down", "testing", "unknown"]
    },
    "oper_status": {
      "enum": ["up", "down", "testing", "dormant", "notPresent", "lowerLayerDown", "unknown"]
    },
    "status": {
      "enum": [
        "healthy",
        "warning",
        "degraded",
        "critical",
        "offline",
        "unknown",
        "maintenance"
      ]
    },
    "speed_bps": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "source_aliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "source",
          "native_id"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "native_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      }
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    }
  }
}