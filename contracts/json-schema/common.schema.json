{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common",
  "$defs": {
    "freshness": {
      "type": "object",
      "required": [
        "state",
        "observed_at",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sourceStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "state",
        "observed_at"
      ],
      "properties": {
        "source": {
          "enum": [
            "netbox",
            "librenms",
            "wazuh"
          ]
        },
        "state": {
          "enum": [
            "ok",
            "not-connected",
            "unknown"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "description": "One read-only source behind a response: whether it was read, and when. Only an ok read carries a time (cross-field: ok has observed_at, the others do not).",
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            }
          },
          "then": {
            "properties": {
              "observed_at": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "not-connected",
                  "unknown"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "observed_at": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
