{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common",
  "$defs": {
    "freshness": {
      "type": "object",
      "required": [
        "state"
      ],
      "properties": {
        "state": {
          "enum": [
            "fresh",
            "stale",
            "unknown"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
