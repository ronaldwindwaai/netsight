{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrafficShared",
  "description": "Definitions shared by the Flow Explorer, Applications, Destinations and Anomalies contracts (timeRange, cohort). The legacy top-talkers / top-destinations response was retired: it returned raw addresses to the aggregate tier outside the cohort rule.",
  "$defs": {
    "timeRange": {
      "description": "Requested window (server-bounded, never source data).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "preset"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "preset": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d"
              ]
            }
          ]
        }
      }
    },
    "cohort": {
      "description": "The small-cohort rule as applied to this answer. not-applied: the caller holds the detail tier (or nothing was read). sufficient: the aggregate tier, and every figure describes at least minimum internal endpoints. too-few-sources: the aggregate tier, and something was withheld because fewer than minimum internal endpoints stood behind it (a whole answer, a row, a series, a first-seen destination).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "minimum"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-applied",
            "sufficient",
            "too-few-sources"
          ]
        },
        "minimum": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 2,
          "maximum": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "not-applied"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "minimum": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "minimum": {
                "type": "integer"
              }
            }
          }
        }
      ]
    }
  }
}
