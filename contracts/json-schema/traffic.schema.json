{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrafficTopResponse",
  "type": "object",
  "required": [
    "state",
    "dimension",
    "time_range",
    "items",
    "freshness"
  ],
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "not-connected",
        "ok",
        "unknown"
      ]
    },
    "dimension": {
      "enum": [
        "talkers",
        "destinations"
      ]
    },
    "time_range": {
      "$ref": "#/$defs/timeRange"
    },
    "items": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "not-connected",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "timeRange": {
      "description": "Requested window (server-bounded, never source data).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "preset"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        },
        "preset": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d"
              ]
            }
          ]
        }
      }
    },
    "subjectKind": {
      "enum": [
        "device",
        "ip",
        "user",
        "application",
        "domain",
        "asn",
        "interface"
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "subject_kind",
        "subject_id",
        "label",
        "bytes",
        "packets",
        "share"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "subject_kind": {
          "$ref": "#/$defs/subjectKind"
        },
        "subject_id": {
          "description": "Canonical ID when the source resolves one; never inferred.",
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "label": {
          "description": "Source-reported label; untrusted, rendered as data only.",
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "packets": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "share": {
          "description": "Fraction of total bytes in the window; null when the source cannot compute it.",
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
