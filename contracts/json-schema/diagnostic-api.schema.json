{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticApi",
  "description": "Request and response envelope of the /api/v1/diagnostics routes (S7). The run record itself is defined in diagnostic.schema.json. A response carries an explicit state: not-connected (no probe capability configured) and unknown (the probe channel failed) never carry a run; only ok does. target, symptom and vantage are untrusted request text and are never interpreted as instructions.",
  "$defs": {
    "runRequest": {
      "description": "Start one read-only diagnostic run against a target. requested_checks selects the bounded checks to attempt; the workflow always establishes identity and source freshness first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "symptom",
        "vantage",
        "requested_checks"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "symptom": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "vantage": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "requested_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "enum": [
              "identity",
              "source-freshness",
              "target-health",
              "dns",
              "icmp",
              "tcp",
              "http",
              "https",
              "service",
              "dependencies",
              "recent-changes",
              "baseline"
            ]
          }
        }
      }
    },
    "runResponse": {
      "description": "The completed run, or an explicit not-connected/unknown state without one. run is non-null exactly when state is ok.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "run"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "ok",
            "unknown"
          ]
        },
        "run": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "diagnostic.schema.json"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "run": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "run": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
