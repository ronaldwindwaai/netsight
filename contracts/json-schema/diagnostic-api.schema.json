{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DiagnosticApi",
  "description": "Request and response envelope of the /api/v1/diagnostics routes (S7). The run record itself is defined in diagnostic.schema.json. A response carries an explicit state: not-connected (no probe capability configured) and unknown (the probe channel failed) never carry a run; only ok does. target, symptom and vantage are untrusted request text and are never interpreted as instructions.",
  "$defs": {
    "runRequest": {
      "description": "Start one read-only diagnostic run against a target. requested_checks selects the bounded checks to attempt; the workflow always establishes identity and source freshness first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "symptom",
        "vantage",
        "requested_checks"
      ],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "symptom": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        },
        "vantage": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "requested_checks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "enum": [
              "identity",
              "source-freshness",
              "target-health",
              "dns",
              "icmp",
              "tcp",
              "http",
              "https",
              "service",
              "dependencies",
              "recent-changes",
              "baseline"
            ]
          }
        }
      }
    },
    "runResponse": {
      "description": "The completed run, or an explicit not-connected/unknown state without one. run is non-null exactly when state is ok. stored is true exactly when the run was persisted as a session (state ok and a session store connected); a run that was not stored cannot be revisited.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "run",
        "stored"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "ok",
            "unknown"
          ]
        },
        "run": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "diagnostic.schema.json"
            }
          ]
        },
        "stored": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "run": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "run": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            },
            "required": [
              "state"
            ]
          },
          "else": {
            "properties": {
              "stored": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "sessionSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "started_at",
        "completed_at",
        "probable_fault_domain",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 47,
          "maxLength": 47,
          "pattern": "^diagnostic-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "probable_fault_domain": {
          "enum": [
            "target",
            "service",
            "host",
            "interface",
            "access-device",
            "core",
            "firewall",
            "wan-dns-external",
            null
          ]
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        }
      },
      "description": "One stored session in the list. target is untrusted request text; the domain is null exactly when confidence is unknown."
    },
    "sessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "session"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "ok",
            "unknown"
          ]
        },
        "session": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "diagnostic-session.schema.json"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "session": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "session": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "One stored session, or an explicit not-connected (no session store configured) / unknown (the store could not be read) state without one. session is non-null exactly when state is ok. An unknown id is an HTTP 404, not a state."
    },
    "sessionListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "sessions",
        "limit",
        "offset",
        "next_offset"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "ok",
            "unknown"
          ]
        },
        "sessions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/sessionSummary"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            },
            "required": [
              "state"
            ]
          },
          "else": {
            "properties": {
              "sessions": {
                "maxItems": 0
              },
              "next_offset": {
                "type": "null"
              }
            }
          }
        }
      ],
      "description": "Stored sessions newest first with an explicit store state; only ok carries rows. The offset is server-capped; next_offset is set when the page was full and the capped offset allows another page."
    }
  }
}
