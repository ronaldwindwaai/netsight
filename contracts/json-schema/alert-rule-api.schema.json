{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlertRuleApi",
  "description": "Request and response envelopes of the /api/v1/alert-rules and /api/v1/maintenance-windows routes (S6-3). The records themselves are defined in alert-rule.schema.json. List and detail responses carry an explicit state: not-connected (no store configured) and unknown (the store failed) never carry rows, a continuation cursor or a record; only ok does. Every free-text field is untrusted data and is never interpreted as an instruction.",
  "$defs": {
    "ruleDefinition": {
      "description": "Operator-editable rule fields: the body of a create request and the definition of an update or dry-run. Lifecycle and audit fields (id, status, version, created_*, approved_*) are server-owned and rejected here. A new rule is always a draft; it becomes active only through the approve operation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "condition",
        "baseline_mode",
        "window_seconds",
        "for_seconds",
        "cooldown_seconds",
        "schedule",
        "exceptions",
        "severity",
        "labels",
        "actions",
        "incident_policy"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "scope": {
          "$ref": "alert-rule.schema.json#/$defs/scope"
        },
        "condition": {
          "$ref": "alert-rule.schema.json#/$defs/condition"
        },
        "baseline_mode": {
          "description": "none: compare against the threshold only; otherwise compare against the baseline detector output (AnomalySignal) in the given direction.",
          "enum": [
            "none",
            "above-baseline",
            "below-baseline",
            "outside-baseline"
          ]
        },
        "window_seconds": {
          "description": "Aggregation window the condition is evaluated over.",
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "for_seconds": {
          "description": "Duration the condition must hold before firing (debounce); 0 fires immediately.",
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        },
        "cooldown_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "schedule": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "alert-rule.schema.json#/$defs/schedule"
            }
          ]
        },
        "exceptions": {
          "$ref": "alert-rule.schema.json#/$defs/exceptions"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "labels": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,62}$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 128
          }
        },
        "actions": {
          "description": "Rule actions. These only create alerts and notifications; remote write actions go through the action framework, never through a rule.",
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "create_alert",
              "email",
              "push"
            ]
          }
        },
        "incident_policy": {
          "enum": [
            "none",
            "create",
            "group"
          ]
        }
      }
    },
    "ruleListResponse": {
      "description": "One page of alert rules, newest first. Paging is a server-capped offset (limit 1-100, offset 0-10000); next_offset is null on the last page. not-connected and unknown never carry rows or a cursor.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "rules",
        "limit",
        "offset",
        "next_offset"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "ok",
            "unknown"
          ]
        },
        "rules": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "alert-rule.schema.json"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "not-connected",
                  "unknown"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "rules": {
                "maxItems": 0
              },
              "next_offset": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ruleDetailResponse": {
      "description": "One alert rule. rule is non-null exactly when state is ok; an unknown id is a 404, not a state.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "rule"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "ok",
            "unknown"
          ]
        },
        "rule": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "alert-rule.schema.json"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "rule": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "rule": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ruleUpdateRequest": {
      "description": "Replace the definition of a draft or disabled rule. expected_version is the version the editor loaded; the edit is refused with 409 when the stored version differs, and an active rule must be disabled first. An edit always returns the rule to draft: it must be approved again.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version",
        "definition"
      ],
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "definition": {
          "$ref": "#/$defs/ruleDefinition"
        }
      }
    },
    "ruleApproveRequest": {
      "description": "Approve (activate) exactly the version the reviewer saw. A rule changed since then is refused with 409; an invalid rule is refused with 422 and stays inactive.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_version"
      ],
      "properties": {
        "expected_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        }
      }
    },
    "windowListResponse": {
      "description": "One page of maintenance windows ordered by start time. Same paging and not-connected/unknown rules as the rule list.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "windows",
        "limit",
        "offset",
        "next_offset"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "ok",
            "unknown"
          ]
        },
        "windows": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "alert-rule.schema.json#/$defs/maintenanceWindow"
          }
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "not-connected",
                  "unknown"
                ]
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "windows": {
                "maxItems": 0
              },
              "next_offset": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "windowDetailResponse": {
      "description": "One maintenance window. window is non-null exactly when state is ok.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "window"
      ],
      "properties": {
        "state": {
          "enum": [
            "not-connected",
            "ok",
            "unknown"
          ]
        },
        "window": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "alert-rule.schema.json#/$defs/maintenanceWindow"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ok"
              }
            },
            "required": [
              "state"
            ]
          },
          "then": {
            "properties": {
              "window": {
                "type": "object"
              }
            }
          },
          "else": {
            "properties": {
              "window": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "windowCreateRequest": {
      "description": "Schedule a maintenance window. Cross-field rules not expressible in JSON Schema and enforced by the API models and the browser parser: ends_at must be after starts_at, at most 30 days later, ends_at must be in the future and starts_at at most one year ahead. A window with organisation scope needs a separate permission.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "scope",
        "starts_at",
        "ends_at",
        "evaluation",
        "reason"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "scope": {
          "$ref": "alert-rule.schema.json#/$defs/scope"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "evaluation": {
          "enum": [
            "retain",
            "disable"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      }
    },
    "evaluateObservation": {
      "description": "One reading of one monitored entity. All text is untrusted data used only for comparison.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "entity",
        "scopes",
        "value",
        "text",
        "anomaly",
        "destination",
        "device_groups"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "entity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "scopes": {
          "description": "Every scope the entity belongs to; the rule only sees entities inside its own scope.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "alert-rule.schema.json#/$defs/scope"
          }
        },
        "value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -1000000000000000,
          "maximum": 1000000000000000
        },
        "text": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "anomaly": {
          "enum": [
            "above",
            "below",
            "normal",
            null
          ]
        },
        "destination": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 255
        },
        "device_groups": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "evaluateWindow": {
      "description": "A sample maintenance window supplied for the dry-run (nothing is read from the store). ends_at must be after starts_at and at most 30 days later (API models and parser).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "starts_at",
        "ends_at",
        "evaluation",
        "status"
      ],
      "properties": {
        "scope": {
          "$ref": "alert-rule.schema.json#/$defs/scope"
        },
        "starts_at": {
          "type": "string",
          "format": "date-time"
        },
        "ends_at": {
          "type": "string",
          "format": "date-time"
        },
        "evaluation": {
          "enum": [
            "retain",
            "disable"
          ]
        },
        "status": {
          "enum": [
            "scheduled",
            "cancelled"
          ]
        }
      }
    },
    "evaluateRequest": {
      "description": "Replay observations through a rule definition at fixed times, with no external effect: nothing is stored, sent or created. Observations must be in strictly ascending time order (API models and parser); each is judged at its own timestamp, so schedules, maintenance windows, for and cooldown are all derived from the supplied times.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "observations",
        "windows"
      ],
      "properties": {
        "definition": {
          "$ref": "#/$defs/ruleDefinition"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/evaluateObservation"
          }
        },
        "windows": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/evaluateWindow"
          }
        }
      }
    },
    "evaluateProblem": {
      "description": "A static configuration problem code and the contract field it concerns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "field"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Z0-9_]+$"
        },
        "field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "evaluateResult": {
      "description": "The engine decision for one observation. notify means a notification would be released; blocked_by says why a firing alert was not notified. maintenance_windows are indexes into the supplied windows.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "at",
        "outcome",
        "phase",
        "transition",
        "notify",
        "blocked_by",
        "maintenance_windows"
      ],
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "firing",
            "pending",
            "not-met",
            "excepted",
            "outside-schedule",
            "no-data",
            "out-of-scope",
            "stale",
            "future",
            "maintenance-disabled",
            "invalid-config",
            "rule-not-active"
          ]
        },
        "phase": {
          "enum": [
            "inactive",
            "pending",
            "firing"
          ]
        },
        "transition": {
          "enum": [
            "fired",
            "resolved",
            null
          ]
        },
        "notify": {
          "type": "boolean"
        },
        "blocked_by": {
          "enum": [
            "maintenance",
            "cooldown",
            null
          ]
        },
        "maintenance_windows": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19
          }
        }
      }
    },
    "evaluateResponse": {
      "description": "Dry-run verdict. valid is false when the definition cannot be evaluated here (fail closed): problems then lists why and results is empty. Otherwise problems is empty and results holds one decision per observation, in order. The dry-run is read-only.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "problems",
        "results"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "problems": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/evaluateProblem"
          }
        },
        "results": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/evaluateResult"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "valid": {
                "const": true
              }
            },
            "required": [
              "valid"
            ]
          },
          "then": {
            "properties": {
              "problems": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "problems": {
                "minItems": 1
              },
              "results": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
