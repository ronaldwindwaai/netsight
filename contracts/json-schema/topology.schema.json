{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TopologyResponse",
  "type": "object",
  "required": [
    "state",
    "nodes",
    "edges",
    "freshness"
  ],
  "additionalProperties": false,
  "properties": {
    "state": {
      "enum": [
        "not-connected",
        "ok",
        "unknown"
      ]
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "not-connected",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "maxItems": 0
          },
          "edges": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "device_id",
        "name",
        "reconciled",
        "finding"
      ],
      "additionalProperties": false,
      "properties": {
        "device_id": {
          "type": "string",
          "pattern": "^device-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "reconciled": {
          "type": "boolean"
        },
        "finding": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nodeFinding"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reconciled": {
                "const": false
              }
            },
            "required": [
              "reconciled"
            ]
          },
          "then": {
            "properties": {
              "finding": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "nodeFinding": {
      "type": "object",
      "required": [
        "kind",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "missing-discovered",
            "status-mismatch"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "source_device_id",
        "target_device_id",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "source_device_id": {
          "type": "string",
          "pattern": "^device-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "target_device_id": {
          "type": "string",
          "pattern": "^device-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "source": {
          "enum": [
            "lldp",
            "cdp",
            "routing",
            "switching",
            "netbox",
            "manual"
          ]
        },
        "observed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    }
  }
}
