{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIAnswer",
  "type": "object",
  "required": [
    "summary",
    "facts",
    "inferences",
    "unknowns",
    "recommendations"
  ],
  "properties": {
    "summary": {
      "type": "string"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
