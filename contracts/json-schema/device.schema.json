{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Device",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "source_aliases",
    "freshness"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^device-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string"
    },
    "hostname": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "type": "string"
    },
    "status": {
      "enum": [
        "healthy",
        "warning",
        "degraded",
        "critical",
        "offline",
        "unknown",
        "maintenance"
      ]
    },
    "ip_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mac_addresses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "site_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "owner_identity_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_aliases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "source",
          "native_id"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "native_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          }
        }
      }
    },
    "freshness": {
      "$ref": "common.schema.json#/$defs/freshness"
    }
  }
}
