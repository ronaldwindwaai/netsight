{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ActionRequest",
  "type": "object",
  "required": [
    "id",
    "action_type",
    "target_id",
    "risk",
    "state",
    "requester_id",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "action_type": {
      "type": "string"
    },
    "target_id": {
      "type": "string"
    },
    "risk": {
      "enum": [
        "A",
        "B",
        "C",
        "D"
      ]
    },
    "state": {
      "enum": [
        "proposed",
        "authorised",
        "rejected",
        "executing",
        "verified",
        "failed",
        "cancelled"
      ]
    },
    "requester_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "minLength": 3
    },
    "approval_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
